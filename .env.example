# ---------------------------------------------------------------------------
# Optional configuration. Copy this file to ".env" and fill in what you want.
# EVERYTHING here is optional — the tool runs fully with no .env file at all.
# ---------------------------------------------------------------------------

# --- AI qualitative layer (optional) ---------------------------------------
# Add an Anthropic key to unlock Claude-written moat/risk/thesis analysis and
# critiques of the auto-generated assumptions. Without a key the tool uses a
# transparent rule-based fallback and still works end to end.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL_ANTHROPIC=claude-sonnet-5

# Or use OpenAI instead:
# OPENAI_API_KEY=sk-...
# AI_MODEL_OPENAI=gpt-4o

# Force a provider ("anthropic" | "openai" | "none" | "auto"). Default: auto.
# AI_PROVIDER=auto

# --- Optional paid market-data keys (not required) -------------------------
# The free stack (yfinance + SEC EDGAR + live Treasury) needs no keys. If you
# later add a paid source you can wire it in here.
# FMP_API_KEY=
# ALPHAVANTAGE_API_KEY=

# --- Options data (ThetaData) — options backtest + scream-buy signals -------
# ThetaData Standard (~$80/mo): tick options history to 2016, quotes, IV, greeks.
# Powers the options backtest (local) and, once live, the scream-buy scan.
# Key from thetadata.net. Risk-free rate comes FREE from FRED, not from here.
# THETADATA_API_KEY=

# --- Tradier PAPER account (the forward out-of-sample track, roadmap #12) ---
# SEPARATE credentials from TRADIER_TOKEN / TRADIER_ENV, which stay pointed at the
# production feed the live app reads. These two are used ONLY by the paper track
# (valuation/edge/paper_broker.py), which refuses to construct against anything but
# https://sandbox.tradier.com/v1 and will not fall back to the production token.
# Get them from a Tradier SANDBOX (paper) account: Preferences -> API Access.
# Without them the track simply does not run; nothing else is affected.
# TRADIER_PAPER_TOKEN=
# TRADIER_PAPER_ACCOUNT_ID=          # e.g. VA12345678
# PAPER_CONTRACTS_PER_TRADE=1        # keeps paper on the backtest's 1-contract basis

# SEC asks for a descriptive User-Agent with contact info (be nice to them):
# SEC_USER_AGENT=your-name your-email@example.com

# --- Valuation defaults (all overridable per-run in the UI) ----------------
# EQUITY_RISK_PREMIUM=0.05
# DEFAULT_RISK_FREE=0.043
# MARGINAL_TAX_RATE=0.21
# TERMINAL_GROWTH_CAP=0.03
# MONTECARLO_TRIALS=10000

# --- Beta launch switches (hosted SaaS mode) -------------------------------
# During beta the whole product is unlocked free for everyone and a banner
# says it's in development. Defaults are ON, so you don't have to set these
# to run the free beta. Flip them when you're ready to start charging.
# BETA_MODE=true             # show the "in beta / in development" banner site-wide
# BETA_ALL_PREMIUM=true      # every signed-in account is treated as Premium, free
# DEMO_ACCESS_TOKEN=preview  # recruiter master-link: visiting /demo/<token> gives
#                            # instant Premium with NO signup. This is what goes on
#                            # your résumé. It keeps working after beta ends, so set
#                            # it to something long/unguessable before you charge.

# --- Edge Lab historical backtest data (optional, research-grade) ----------
# The backtest of the full model vs the S&P needs point-in-time, survivorship-free
# data. Pick ONE provider. One Sharadar/Nasdaq-Data-Link key covers all its tables
# (SEP prices + SF1 fundamentals + SF2 insiders + SF3A institutional).
# EDGE_DATA_PROVIDER=sharadar        # "free" (default) | "sharadar" | "wrds"
# SHARADAR_API_KEY=                  # your Nasdaq Data Link key
# WRDS_DATA_DIR=                     # OR a folder of CRSP/Compustat exports (free via William & Mary)
# Backtest knobs (all optional; sensible defaults):
# BACKTEST_UNIVERSE_LIMIT=1000       # names to include (whole market can be thousands of API calls)
# BACKTEST_LOOKBACK_YEARS=18         # long history, but recency-weighted below
# BACKTEST_HORIZONS=63,252           # holding horizons to test (trading days: ~3mo, 12mo)
# BACKTEST_REBALANCE_DAYS=63
# BACKTEST_TOP_N=25
# BACKTEST_RECENCY_HALFLIFE_YEARS=5  # weight recent history more when choosing weights

# --- Self-learning (OFF, and leave it off) ---------------------------------
# LEARN_ENABLED=false
#   The monthly out-of-sample-gated re-tune of the SCREENER's live factor weights.
#   DEFAULTS FALSE since 2026-08-14 (master audit MA1). It used to default TRUE and appeared in
#   no documentation at all, while a monthly GitHub cron POSTed /admin/run-learning — so a
#   scheduled job could change the weights the live hot list is scored with by writing a row
#   into Render's database: no code commit, no diff, no review.
#   Adopting weights is a VINTAGE EVENT under PAPER_TRACK_CONTRACT Amendment 1 (it closes the
#   current vintage and restarts the five-year clock), and a database row cannot do that.
#   Setting this true is NOT enough to adopt anything: the learner independently refuses unless
#   an OPEN vintage in track_meter.VINTAGES authorises learned weights for that bucket. Both
#   would have to be done deliberately. Anything other than the exact string "true" is off.
# LEARN_MIN_DATES=8                  # distinct scan dates with a realized forward return
# LEARN_HORIZON_DAYS=21              # forward-return window used to score a scan date
# LEARN_TOP_PER_DATE=60              # names per date fed to the learner

# --- Screaming-buy alerts (optional) ---------------------------------------
# Push high-conviction bullish options setups to Discord + opt-in email, fired
# after each intraday scan and de-duped to once per ticker per day.
# DISCORD_WEBHOOK_URL=       # your Discord channel webhook (owner-level, like On The Steps)
# ALERT_MIN_SCORE=80         # score a signal must clear to alert (default 80)
# Email alerts also need SMTP_* set, and each user must opt in on their account page.
