# ═══════════════════════════════════════════════════════════════════════════
#  quant_bots — ONE combined .env for all FOUR bots
# ═══════════════════════════════════════════════════════════════════════════
# Copy this to `.env` (same folder) and fill in what you need:
#     cp .env.example .env   &&   nano .env
#
# All four bots read this single file. Each bot uses ONLY its own credentials
# (no shared fallback) EXCEPT the reversion bot, which falls back to the shared
# TRADIER_TOKEN if its own isn't set — convenient for SIM, which only needs
# quotes. A bot with no usable credentials simply declines to start (clean
# exit) without affecting the others, so you can fill in one at a time.
#
# FOR THE SIM PILOT: the simplest setup is to put the SAME sandbox token and
# account in every TOKEN/ACCOUNT field below. SIM only pulls quotes, so one
# sandbox login serves all four. Leave ANTHROPIC_API_KEY blank (irrelevant to
# SIM). Set BOT_MODE=sim at the bottom.

# ─── Bot #1: Options (put credit spreads) ───────────────────────────────────
TRADIER_TOKEN=
TRADIER_ACCOUNT_ID=
TRADIER_SANDBOX=true
# Optional: enables the LLM advisory layer (flag-and-log binary-event check on
# the options bot only; never blocks trades). Blank = off. Costs a small amount
# of API spend per opening candidate. Set ADVISORY_MODEL to override the model.
ANTHROPIC_API_KEY=

# ─── Bot #2: Trend-following ────────────────────────────────────────────────
TREND_TRADIER_TOKEN=
TREND_TRADIER_ACCOUNT_ID=
TREND_TRADIER_SANDBOX=true

# ─── Bot #3: Cross-sectional momentum ───────────────────────────────────────
MOMENTUM_TRADIER_TOKEN=
MOMENTUM_TRADIER_ACCOUNT_ID=
MOMENTUM_TRADIER_SANDBOX=true

# ─── Bot #4: Mean-reversion ─────────────────────────────────────────────────
# Optional — if left blank, this bot falls back to the shared TRADIER_TOKEN /
# TRADIER_ACCOUNT_ID above (fine for SIM). Set its own only for paper/live.
REVERSION_TRADIER_TOKEN=
REVERSION_TRADIER_ACCOUNT_ID=
REVERSION_TRADIER_SANDBOX=true

# ─── Shared settings (genuinely shared — not account credentials) ───────────
# Discord webhook for notifications. Blank = log instead of send.
DISCORD_WEBHOOK_URL=

# Trading mode for whichever bot you launch:
#   preview_only (default, safe) | sim | paper | live
BOT_MODE=sim
# Required ONLY for live, alongside BOT_MODE=live and that bot's SANDBOX=false:
# BOT_ALLOW_LIVE=YES_I_UNDERSTAND
