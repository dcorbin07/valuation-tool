# ── Copy to ".env" and fill in. Never commit the real .env. ──

# Anthropic (deep dives + self-review)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# SEC EDGAR requires a User-Agent identifying you (name + email)
EDGAR_USER_AGENT=Don Corbin don@example.com

# Discord webhooks — one per channel
DISCORD_WEBHOOK_DAILY=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_INSIDER=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_IMPROVE=https://discord.com/api/webhooks/...

# Optional: where the SQLite db lives (defaults to ./screener.db)
SCREENER_DB=screener.db
